{
  "playwright": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "@playwright/mcp@latest",
      "--browser",
      "chromium",
      "--viewport-size",
      "1280x720",
      "--user-data-dir",
      "${PLAYWRIGHT_MCP_DIR}/profile",
      "--output-dir",
      "${PLAYWRIGHT_MCP_DIR}/output",
      "--secrets",
      "${PLAYWRIGHT_MCP_DIR}/secrets.env"
    ],
    "env": {}
  }
}
